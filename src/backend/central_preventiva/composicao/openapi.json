  "info": {
    "description": "Disponibiliza somente os recursos implementados da Central Preventiva, com dados sintéticos e sem envio real.",
    "summary": "API local da prova de conceito educacional.",
    "title": "Central Preventiva",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/dados-sinteticos/restauracoes": {
      "post": {
        "description": "Repõe o conjunto sintético versionado em uma única transação. Exige o cabeçalho `Idempotency-Key` em toda requisição.",
        "operationId": "restaurar_api_v1_dados_sinteticos_restauracoes_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaRestauracao"
                }
              }
            },
            "description": "Dados sintéticos restaurados."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemaRestauracao"
                }
              }
            },
            "description": "Restauração recusada sem qualquer mutação."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemaRestauracao"
                }
              }
            },
            "description": "Requisição sem o cabeçalho `Idempotency-Key`."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemaRestauracao"
                }
              }
            },
            "description": "Falha ao concluir a transação de restauração."
          }
        },
        "summary": "Restaurar os dados sintéticos da demonstração",
        "tags": [
          "Dados sintéticos"
        ]
      }
    },
    "/api/v1/meteorologia/cenarios-sinteticos/{identificador}/ativar": {
      "post": {
        "description": "Ativa, de forma idempotente, o cenário sintético de contingência informado para a área monitorada indicada. O evento resultante tem `proveniencia = sintetico`, nunca combinado com dados `real_inmet`. Exige o cabeçalho `Idempotency-Key` em toda requisição.",
