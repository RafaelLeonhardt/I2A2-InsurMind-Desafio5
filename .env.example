# Copie este arquivo para .env e mantenha os serviços restritos ao loopback.
CENTRAL_PREVENTIVA_HOST_API=127.0.0.1
CENTRAL_PREVENTIVA_ORIGEM_FRONTEND=http://127.0.0.1:5173
# Arquivo operacional do DuckDB, recriável pelas migrações e pelo seed versionados.
# Caminhos relativos são resolvidos a partir da raiz do repositório.
CENTRAL_PREVENTIVA_CAMINHO_BANCO=var/central_preventiva.duckdb
# Credencial da OpenAI usada pela sonda de prontidão; deixe vazia para reportar indisponível.
OPENAI_API_KEY=
# Endpoint público do INMET sondado pela verificação de prontidão.
CENTRAL_PREVENTIVA_URL_BASE_INMET=