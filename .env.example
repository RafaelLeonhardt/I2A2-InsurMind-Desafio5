# Copie este arquivo para .env e mantenha os serviços restritos ao loopback.
CENTRAL_PREVENTIVA_HOST_API=127.0.0.1
CENTRAL_PREVENTIVA_ORIGEM_FRONTEND=http://127.0.0.1:5151
# Arquivo operacional do DuckDB, recriável pelas migrações e pelo seed versionados.
# Caminhos relativos são resolvidos a partir da raiz do repositório.
CENTRAL_PREVENTIVA_CAMINHO_BANCO=var/central_preventiva.duckdb
# Credencial da OpenAI, lida somente daqui: sonda de prontidão e preflight de IA.
# Deixe vazia para reportar indisponível; nenhum outro lugar lê ou grava a chave.
OPENAI_API_KEY=
# Endpoint público do INMET sondado pela verificação de prontidão.
CENTRAL_PREVENTIVA_URL_BASE_INMET=
# Endereço base da OpenAI usado pela sonda de prontidão e pelo preflight de IA. Mantenha o
# valor real em uso normal; a suíte E2E o aponta para o servidor de dublês local.
CENTRAL_PREVENTIVA_URL_BASE_OPENAI=https://api.openai.com
# Parâmetros da produção agêntica. Um valor malformado aqui bloqueia a inicialização do
# backend; um modelo bem formado que não existe no catálogo da OpenAI é falha de preflight,
# não de inicialização.
# Modelo usado na geração: uma palavra, sem espaços.
CENTRAL_PREVENTIVA_MODELO_OPENAI=gpt-4o-mini
# Temperatura da geração, entre 0.0 e 2.0.
CENTRAL_PREVENTIVA_TEMPERATURA_OPENAI=0.2
# Versão do prompt registrada em cada geração, no formato vN.
CENTRAL_PREVENTIVA_VERSAO_PROMPT=v1
# Limite operacional, em segundos, de cada chamada à OpenAI.
CENTRAL_PREVENTIVA_TIMEOUT_OPENAI_SEGUNDOS=15.0
# Limites de tamanho por canal, em caracteres Unicode do texto final já formatado (não
# bytes, não tokens). São os defaults de demonstração: o limite de uma mensagem de template
# do WhatsApp Business, um segmento SMS GSM-7, a linha de assunto convencional de e-mail e
# um corpo de e-mail curto. Toda saída do agente redator é validada contra eles antes de
# seguir para a crítica.
CENTRAL_PREVENTIVA_LIMITE_CARACTERES_WHATSAPP=1024
CENTRAL_PREVENTIVA_LIMITE_CARACTERES_SMS=160
CENTRAL_PREVENTIVA_LIMITE_CARACTERES_ASSUNTO_EMAIL=78
CENTRAL_PREVENTIVA_LIMITE_CARACTERES_CORPO_EMAIL=2000